{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "hermes-dashboard",
        "namespace": "hermes"
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "hermes-karem"
        },
        "ports": [
          {
            "name": "http",
            "port": 80,
            "targetPort": 9119
          }
        ]
      }
    },
    {
      "apiVersion": "cert-manager.io/v1",
      "kind": "Certificate",
      "metadata": {
        "name": "hermes-dashboard",
        "namespace": "hermes"
      },
      "spec": {
        "secretName": "hermes-dashboard-tls",
        "dnsNames": [
          "hermes.murabba.net"
        ],
        "issuerRef": {
          "kind": "ClusterIssuer",
          "name": "letsencrypt-prod"
        }
      }
    },
    {
      "apiVersion": "traefik.io/v1alpha1",
      "kind": "Middleware",
      "metadata": {
        "name": "hermes-dashboard-security",
        "namespace": "hermes"
      },
      "spec": {
        "headers": {
          "contentTypeNosniff": true,
          "referrerPolicy": "no-referrer",
          "stsSeconds": 15552000
        }
      }
    },
    {
      "apiVersion": "traefik.io/v1alpha1",
      "kind": "Middleware",
      "metadata": {
        "name": "hermes-dashboard-rate-limit",
        "namespace": "hermes"
      },
      "spec": {
        "rateLimit": {
          "average": 120,
          "burst": 40,
          "period": "1m"
        }
      }
    },
    {
      "apiVersion": "traefik.io/v1alpha1",
      "kind": "Middleware",
      "metadata": {
        "name": "hermes-dashboard-https",
        "namespace": "hermes"
      },
      "spec": {
        "redirectScheme": {
          "scheme": "https",
          "permanent": true
        }
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "hermes-dashboard",
        "namespace": "hermes",
        "annotations": {
          "traefik.ingress.kubernetes.io/router.entrypoints": "websecure",
          "traefik.ingress.kubernetes.io/router.middlewares": "hermes-hermes-dashboard-security@kubernetescrd,hermes-hermes-dashboard-rate-limit@kubernetescrd"
        }
      },
      "spec": {
        "ingressClassName": "traefik",
        "tls": [
          {
            "hosts": [
              "hermes.murabba.net"
            ],
            "secretName": "hermes-dashboard-tls"
          }
        ],
        "rules": [
          {
            "host": "hermes.murabba.net",
            "http": {
              "paths": [
                {
                  "path": "/",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "hermes-dashboard",
                      "port": {
                        "name": "http"
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "hermes-dashboard-redirect",
        "namespace": "hermes",
        "annotations": {
          "traefik.ingress.kubernetes.io/router.entrypoints": "web",
          "traefik.ingress.kubernetes.io/router.middlewares": "hermes-hermes-dashboard-https@kubernetescrd"
        }
      },
      "spec": {
        "ingressClassName": "traefik",
        "rules": [
          {
            "host": "hermes.murabba.net",
            "http": {
              "paths": [
                {
                  "path": "/",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "hermes-dashboard",
                      "port": {
                        "name": "http"
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "hermes-dashboard-from-traefik",
        "namespace": "hermes"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "hermes-karem"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "traefik"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "traefik"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 9119
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "hermes-acme-from-traefik",
        "namespace": "hermes"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "acme.cert-manager.io/http01-solver": "true"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "traefik"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "traefik"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 8089
              }
            ]
          }
        ]
      }
    }
  ]
}
