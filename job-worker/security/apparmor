#include <tunables/global>
profile hermes-jobs-browser flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  capability,
  file,
  umount,
  signal,
  ptrace (read, trace) peer=hermes-jobs-browser,
  userns,
  deny mount,
  deny /proc/sys/** wklx,
  deny /proc/sysrq-trigger rwklx,
  deny /proc/kcore rwklx,
  deny /proc/keys rwklx,
  deny /sys/** wklx,
}
