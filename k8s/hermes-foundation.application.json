{
  "apiVersion": "argoproj.io/v1alpha1",
  "kind": "Application",
  "metadata": {
    "name": "hermes-foundation",
    "namespace": "argocd"
  },
  "spec": {
    "project": "default",
    "source": {
      "repoURL": "git@github.com:egyhaty/hermes-assistant.git",
      "targetRevision": "5f5b366d1831d84e65df3fab8c0ff372f5c09d39",
      "path": "deploy"
    },
    "destination": {
      "server": "https://kubernetes.default.svc",
      "namespace": "hermes"
    },
    "syncPolicy": {
      "syncOptions": [
        "PruneLast=true"
      ]
    }
  }
}
